# AI SEO Agent — Environment Configuration Example
#
# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is already listed in .gitignore.

# --- LLM Provider Switch -----------------------------------------------------
# The single switch: change this value (and make sure the matching API key
# below is set) to swap providers everywhere with no code changes.
# One of: gemini | perplexity | openai
LLM_PROVIDER=gemini

# --- Gemini (used when LLM_PROVIDER=gemini) ----------------------------------
# Uses the google-genai SDK's Interactions API with the google_search tool for
# live-web research calls; report-writing calls are tool-free.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=high

# --- Perplexity (used when LLM_PROVIDER=perplexity) --------------------------
# sonar-pro is always search-grounded, so both report and research calls
# include live citations at no extra token cost or added latency.
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_RETRY_ATTEMPTS=3
PERPLEXITY_RETRY_BACKOFF_BASE_SECONDS=1.0

# --- OpenAI (used when LLM_PROVIDER=openai) ----------------------------------
# Uses the Responses API; research calls force the web_search tool
# (tool_choice=required), which adds latency and token cost relative to a
# tool-free report call. search_context_size trades result thoroughness
# for cost/latency (low | medium | high).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium
OPENAI_SEARCH_CONTEXT_SIZE=high

# --- Shared LLM retry settings (Gemini/OpenAI; Perplexity uses its own above) -
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_BASE_SECONDS=1.0

# --- HTTP Fetch ---------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_REDIRECTS=5
FETCH_RETRY_ATTEMPTS=3
FETCH_RETRY_BACKOFF_BASE_SECONDS=0.5
WAYBACK_FALLBACK_ENABLED=true

# --- PageSpeed Insights (Core Web Vitals / Performance) ------------------------
PAGESPEED_ENABLED=true
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_SECONDS=30

# --- Sitemap Inventory / Crawl Sampling -----------------------------------------
SITEMAP_INVENTORY_LIMIT=500
SITEMAP_INDEX_MAX_DEPTH=3
CRAWL_SAMPLE_LIMIT=30
CRAWL_CORE_PAGE_LIMIT=10
CRAWL_SAMPLE_PER_TYPE_LIMIT=5
CRAWL_CONCURRENCY=5
CRAWL_MAX_PAGE_BYTES=2000000
CRAWL_JS_SHELL_WORD_THRESHOLD=50
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000

# --- Report Storage -------------------------------------------------------------
REPORTS_DIR=reports

# --- Report Pipeline --------------------------------------------------------------
USE_NEW_REPORT_PIPELINE=false

# --- Application ------------------------------------------------------------------
APP_TITLE=AI SEO Agent
APP_VERSION=0.1.0
DEBUG=false
